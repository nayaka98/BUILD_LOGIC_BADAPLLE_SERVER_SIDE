local function GetGridFromMouse()

	local Target=Mouse.Target
	local Hit=Mouse.Hit

	if not Hit then
		return nil
	end

	local WorldPos=Hit.Position

	-- Kalau klik surface atas, naikkan sedikit biar grid cell di atas permukaan
	if Target and Target:IsA("BasePart") then
		local Normal=Mouse.TargetSurface
		if Normal==Enum.NormalId.Top then
			WorldPos=
				WorldPos+
				Vector3.new(0,GRANDEUR_BLOC*0.1,0)
		end
	end

	local Grid=PosMonde2Grille(WorldPos)

	-- Baseplate di Y-1 → force Y=0
	if Grid.Y<0 then
		Grid=Vector3.new(Grid.X,0,Grid.Z)
	end

	-- Clamp ke range map 0–255
	local X=
		math.clamp(
			math.floor(Grid.X),
			0,
			255
		)
	local Y=
		math.clamp(
			math.floor(Grid.Y),
			0,
			255
		)
	local Z=
		math.clamp(
			math.floor(Grid.Z),
			0,
			255
		)

	return Vector3.new(X,Y,Z)

end

