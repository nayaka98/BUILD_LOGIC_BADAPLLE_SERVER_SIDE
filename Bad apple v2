local function MathRound(Value)

	return math.floor(
		Value+0.5
	)

end

local OriginPosition=
	PosOriginPart.Position

local function PosMonde2Grille(WorldPosition)

	local X=
		MathRound(
			(WorldPosition.X-OriginPosition.X)/
			GRANDEUR_BLOC
		)

	local Y=
		MathRound(
			(WorldPosition.Y-OriginPosition.Y)/
			GRANDEUR_BLOC
		)

	local Z=
		MathRound(
			(WorldPosition.Z-OriginPosition.Z)/
			GRANDEUR_BLOC
		)

	return Vector3.new(
		X,
		Y,
		Z
	)

end

local function GridToWorld(X,Y,Z)

	return
		OriginPosition+
		Vector3.new(
			X*GRANDEUR_BLOC,
			Y*GRANDEUR_BLOC,
			Z*GRANDEUR_BLOC
		)

end

local function Position2CodePosition(Position)

	local X=
		math.floor(
			tonumber(Position.X)
			or
			-1
		)

	local Y=
		math.floor(
			tonumber(Position.Y)
			or
			-1
		)

	local Z=
		math.floor(
			tonumber(Position.Z)
			or
			-1
		)

	if
		X<0
		or
		X>=256
		or
		Y<0
		or
		Y>=256
		or
		Z<0
		or
		Z>=256
	then
		return nil
	end

	local Buffer=
		BitBuffer:Create()

	Buffer:WriteUnsigned(
		8,
		X
	)

	Buffer:WriteUnsigned(
		8,
		Y
	)

	Buffer:WriteUnsigned(
		8,
		Z
	)

	return
		Buffer:ToBase64()

end

local function NewRunToken()

	RunToken+=1
