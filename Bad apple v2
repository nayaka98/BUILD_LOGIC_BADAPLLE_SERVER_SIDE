local function GetCharacter(
	Frame,
	X,
	Y
)

	local FrameY=
		Y_SIZE-
		1-
		Y

	local Index=
		FrameY*
		X_SIZE+
		X+
		1

	local Byte=
		string.byte(
			Frame,
			Index
		)

	if Byte==65 then
		return "A"
	end

	if Byte==66 then
		return "B"
	end

	return nil

end

local function GetRGBColor(
	Frame,
	X,
	Y
)

	local FrameY=
		Y_SIZE-
		1-
		Y

	local Index=
		FrameY*
		X_SIZE+
		X+
		1

	return Frame[Index]

end

local function PrepareABFrame(
	Frame,
	FirstFrame
)

	local Workers=
		table.create(
			PAINT_WORKERS
		)

	local Counts=
		table.create(
			PAINT_WORKERS,
			0
		)

	for Worker=1,
		PAINT_WORKERS
	do

		Workers[Worker]={}

	end

	local Position=0

	for Y=0,
		Y_SIZE-1
	do

		for X=0,
			X_SIZE-1
		do

			Position+=1

			local Worker=
				(
					Position-
					1
				)%
				PAINT_WORKERS+
				1

			local Character=
				GetCharacter(
					Frame,
					X,
					Y
				)

			if
				Character=="A"
				or
				Character=="B"
			then

				local Key=
					string.format(
						"%d_%d_%d",
						X+START_X,
						Y+START_Y,
						START_Z
					)

				local Data=
					Blocks[Key]

				if Data then

					local Old=
						PreviousPixels[Key]

					if
						FirstFrame
						or
						Old~=Character
					then

						local Count=
							Counts[Worker]+1

						Counts[Worker]=
							Count

						Workers[Worker][Count]=
							{
								Box=Data.box,

								Color=
									Character=="A"
									and
									WHITE
									or
									BLACK,

								Key=Key,
								Value=Character
							}

					end

				end

			end

		end

	end

	return
		Workers,
		Counts

end

local function PrepareRGBFrame(
	Frame,
	FirstFrame
)

	local Workers=
		table.create(
			PAINT_WORKERS
		)

	local Counts=
		table.create(
			PAINT_WORKERS,
			0
		)

	for Worker=1,
		PAINT_WORKERS
	do

		Workers[Worker]={}

	end

	local Position=0

	for Y=0,
		Y_SIZE-1
	do

		for X=0,
			X_SIZE-1
		do

			Position+=1

			local Worker=
				(
					Position-
					1
				)%
				PAINT_WORKERS+
				1

			local Key=
				string.format(
					"%d_%d_%d",
					X+START_X,
					Y+START_Y,
					START_Z
				)

			local Data=
				Blocks[Key]

			local Color=
				GetRGBColor(
					Frame,
					X,
					Y
				)

			if
				Data
				and
				Color
			then

				local Old=
					PreviousPixels[Key]

				local Changed=
					FirstFrame

				if
					not Changed
					and
					Old
				then

					if
						type(Old)=="table"
					then

						Changed=
							Old.R~=Color.R
							or
							Old.G~=Color.G
							or
							Old.B~=Color.B

					else

						Changed=true

					end

				end

				if Changed then

					local Count=
						Counts[Worker]+1

					Counts[Worker]=
						Count

					Workers[Worker][Count]=
						{
							Box=Data.box,
							Color=Color,
							Key=Key,

							Value=
								{
									R=Color.R,
									G=Color.G,
									B=Color.B
								}
						}

				end

			end

		end

	end

	return
		Workers,
		Counts

end

local function CommitFrame(
	Workers,
	Counts
)

	for Worker=1,
		PAINT_WORKERS
	do

		local Items=
			Workers[Worker]

		local Count=
			Counts[Worker]

		for Index=1,
			Count
		do

			local Item=
				Items[Index]

			PreviousPixels[
				Item.Key
			]=
				Item.Value

		end

	end

end

local function PaintPreparedFrame(
	Workers,
	Counts,
	Token
)

	local ActiveWorkers=0
	local FinishedWorkers=0

	for Worker=1,
		PAINT_WORKERS
	do

		local Count=
			Counts[Worker]

		if Count>0 then

			ActiveWorkers+=1

			task.spawn(function()

				local Items=
					Workers[Worker]

				local Index=1

				while
					Index<=Count
				do

					if
						IsCancelled(Token)
					then

						break

					end

					local EndIndex=
						math.min(
							Index+
							PAINT_BATCH-
							1,
							Count
						)

					for ItemIndex=Index,
						EndIndex
					do

						if
							IsCancelled(Token)
						then

							break

						end

						local Item=
							Items[ItemIndex]

						PaintBox(
							Item.Box,
							Item.Color
						)

					end

					Index=
						EndIndex+
						1

					if
						Index<=Count
						and
						not IsCancelled(Token)
					then

						task.wait()

					end

				end

				FinishedWorkers+=1

			end)

		end

	end

	if
		ActiveWorkers==0
	then

		return
			not IsCancelled(Token)

	end

	while
		FinishedWorkers<
		ActiveWorkers
	do

		if
			IsCancelled(Token)
		then

			return false

		end

		task.wait()

	end

	return
		not IsCancelled(Token)

end

local function PaintFrame(
	Frame,
	FirstFrame,
	Token,
	RGBMode
)

	local Workers
	local Counts

	if RGBMode then

		Workers,Counts=
			PrepareRGBFrame(
				Frame,
				FirstFrame
			)

	else

		Workers,Counts=
			PrepareABFrame(
				Frame,
				FirstFrame
			)

	end

	local TotalChanges=0

	for Worker=1,
		PAINT_WORKERS
	do

		TotalChanges+=
			Counts[Worker]

	end

	if
		TotalChanges==0
	then

		return true

	end

	local OK=
		PaintPreparedFrame(
			Workers,
			Counts,
			Token
		)

	if
		not OK
		or
		IsCancelled(Token)
	then

		return false

	end

	CommitFrame(
		Workers,
		Counts
	)

	return true

end

