	if RGBMode then

		return LoadRGB()

	end

	return LoadBadApple()

end

local function PlayStartup(
	Token
)

	local StartTime=
		os.clock()

	local FrameIndex=1
	local FirstFrame=true

	while true do

		if
			IsCancelled(Token)
		then

			return false

		end

		local Frame=
			StartupFrames[
				FrameIndex
			]

		if not Frame then

			FrameIndex=1
			Frame=StartupFrames[1]

		end

		local FrameStart=
			os.clock()

		local OK=
			PaintFrame(
				Frame,
				FirstFrame,
				Token,
				true
			)

		FirstFrame=false

		if not OK then
			return false
		end

		FrameIndex+=1

		if
			FrameIndex>
			#StartupFrames
		then

			FrameIndex=1

		end

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

		local Elapsed=
			os.clock()-
			StartTime

		Status.Text=
			string.format(
				"STARTUP RGB %.1f/%.1f",
				math.min(
					Elapsed,
					STARTUP_DURATION
				),
				STARTUP_DURATION
			)

		if
			Elapsed>=
			STARTUP_DURATION
		then

			return true

		end

	end

end

local function PlayMode(
