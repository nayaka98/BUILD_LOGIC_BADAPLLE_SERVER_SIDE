local function IsCancelled(Token)

	return
		StopRequested
		or
		Token~=RunToken

end

local function PlaceBlock(Data)

	local OK,Result=
		pcall(function()

			return
				PlacerBloc:InvokeServer(
					BLOCK_ID,
					Data.code,
					nil,
					nil,
					Data.key,
					"A"
				)

		end)

	if not OK then

		return false,
			tostring(Result)

	end

	return true

end

local function CacheBoxesFromWorkspace()

	local Found=0

	for _,Object in
		ipairs(
			Blocs:GetDescendants()
		)
	do

		if
			Object:IsA("BasePart")
			and
			Object.Name=="Box"
		then

			local Grid=
				PosMonde2Grille(
					Object.Position
				)

			local X=Grid.X
			local Y=Grid.Y
			local Z=Grid.Z

			if
				X>=START_X
				and
				X<START_X+X_SIZE
				and
				Y>=START_Y
				and
				Y<START_Y+Y_SIZE
				and
				Z==START_Z
			then

				local Expected=
					GridToWorld(
						X,
						Y,
						Z
					)

				if
					(
						Object.Position-
						Expected
					).Magnitude
					<=SCAN_RADIUS
				then

					local Key=
						string.format(
							"%d_%d_%d",
							X,
							Y,
							Z
						)

					if not Blocks[Key] then

						Blocks[Key]=
							{
								x=X,
								y=Y,
								z=Z,
								key=Key,

								code=
									Position2CodePosition(
										Grid
									),

								world=Expected,
								box=Object
							}

						Found+=1

					end

				end

			end

		end

	end

	return Found

end

local function WaitForBuiltBoxes(Token)

	local Found=0

	for _=1,
		BUILD_RESCAN_ATTEMPTS
	do

		if IsCancelled(Token) then
			return false,Found
		end

		Found=
			CacheBoxesFromWorkspace()

		Status.Text=
			string.format(
				"SYNC BLOCKS %d/%d",
				Found,
				TOTAL_BLOCKS
			)

		if
			Found>=TOTAL_BLOCKS
		then

			return true,Found

		end

		task.wait(
			BUILD_RESCAN_DELAY
		)

	end

	return
		Found>0,
		Found

end

local function PrepareBuildData()

	local Data=
		table.create(
			TOTAL_BLOCKS
		)

	local Index=0

	for Y=START_Y,
		START_Y+Y_SIZE-1
	do

		for X=START_X,
			START_X+X_SIZE-1
		do

			Index+=1

			local Grid=
				Vector3.new(
					X,
					Y,
					START_Z
				)

			Data[Index]=
				{
					x=X,
					y=Y,
					z=START_Z,

					key=
						string.format(
							"%d_%d_%d",
							X,
							Y,
							START_Z
						),

					code=
						Position2CodePosition(
							Grid
						),

					world=
						GridToWorld(
							X,
							Y,
							START_Z
						)
				}

		end

	end

	return Data

end

local function BuildGrid()

	if
		Building
		or
		Playing
		or
		Scanning
	then

		if Playing then
			Status.Text="PLAYBACK ACTIVE"
		end

		return

	end

	Building=true

	local Token=
		NewRunToken()

	table.clear(
		Blocks
	)

	Status.Text=
		"PREPARING BUILD..."

	local BuildData=
		PrepareBuildData()

	local NextIndex=0
	local Completed=0
	local Failed=0
	local WorkersDone=0

	local function Worker()

		while true do

			if IsCancelled(Token) then
				break
			end

			local Index=
				NextIndex+1

			NextIndex=Index

			if
				Index>TOTAL_BLOCKS
			then
				break
			end

			local Data=
				BuildData[Index]

			local Success,Error=
				PlaceBlock(Data)

			if IsCancelled(Token) then
				break
			end

			if Success then

				Completed+=1

			else

				Failed+=1

				warn(
					"[BUILD]",
					Data.x,
					Data.y,
					Error
				)

			end

			if
				Completed%BUILD_BATCH==0
			then

				Status.Text=
					string.format(
						"BUILD %d/%d",
						Completed,
						TOTAL_BLOCKS
					)

				task.wait()

			end

		end

		WorkersDone+=1

	end

	for _=1,
		BUILD_WORKERS
	do

		task.spawn(
			Worker
		)

	end

	while
		WorkersDone<
		BUILD_WORKERS
	do

		if IsCancelled(Token) then

			Building=false
			Status.Text="STOPPED"

			return

		end

		Status.Text=
			string.format(
				"BUILD %d/%d",
				Completed,
				TOTAL_BLOCKS
			)

		task.wait()

	end

	if IsCancelled(Token) then

		Building=false
		Status.Text="STOPPED"

		return

	end

	Status.Text=
		string.format(
			"PLACED %d/%d",
			Completed,
			TOTAL_BLOCKS
		)

	task.wait(0.25)

	if IsCancelled(Token) then

		Building=false
		Status.Text="STOPPED"

		return

	end

	local Synced,Found=
		WaitForBuiltBoxes(
			Token
		)

	Building=false

	if not Synced then

		if IsCancelled(Token) then
			Status.Text="STOPPED"
		else
			Status.Text=
				string.format(
					"BUILD DONE • %d BOX",
					Found
				)
		end

		return

	end

	Status.Text=
		string.format(
			"READY • %d/%d BLOCKS",
			Found,
			TOTAL_BLOCKS
		)

	print(
		"BUILD:",
		Completed,
		"/",
		TOTAL_BLOCKS
	)

	print(
		"FAILED:",
		Failed
	)

	print(
		"CACHED:",
		Found
	)

end

