local function LoadText(URL)

	local OK,Text=
		pcall(function()

			return game:HttpGet(
				URL,
				true
			)

		end)

	if
		not OK
		or
		type(Text)~="string"
	then

		return nil

	end

	Text=
		Text:gsub(
			"\239\187\191",
			""
		)

	return Text:gsub(
		"\r",
		""
	)

end

local function ParseRGBFrame(Text)

	local Pixels=
		table.create(
			TOTAL_BLOCKS
		)

	local Count=0

	for R,G,B in
		Text:gmatch(
			"(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
		)
	do

		R=tonumber(R)
		G=tonumber(G)
		B=tonumber(B)

		if
			R and G and B
			and
			R>=0
			and
			R<=255
			and
			G>=0
			and
			G<=255
			and
			B>=0
			and
			B<=255
		then

			Count+=1

			if
				Count>TOTAL_BLOCKS
			then

				return nil

			end

			Pixels[Count]=
				Color3.fromRGB(
					R,
					G,
					B
				)

		end

	end

	if
		Count~=TOTAL_BLOCKS
	then

		return nil

	end

	return Pixels

end

local function LoadRGBFrames(
	URL,
	StatusText,
	EmptyText
)

	if
		not URL
		or
		URL==""
	then

		Status.Text=
			"RGB URL EMPTY"

		return nil

	end

	Status.Text=
		StatusText

	local Text=
		LoadText(
			URL
		)

	if not Text then

		Status.Text=
			"DOWNLOAD FAILED"

		return nil

	end

	Text=
		Text:gsub(
			"%s",
			""
		)

	local Frames={}

	for _,FrameText in
		ipairs(
			string.split(
				Text,
				"N"
			)
		)
	do

		if
			#FrameText>0
		then

			local Frame=
				ParseRGBFrame(
					FrameText
				)

			if Frame then

				Frames[
					#Frames+1
				]=Frame

			end

		end

	end

	if
		#Frames==0
	then

		Status.Text=
			EmptyText

		return nil

	end

	return Frames

end

