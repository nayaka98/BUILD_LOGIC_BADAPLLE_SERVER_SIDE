end

local function PlayStartup(
	Token
)

	local StartTime=
		os.clock()

	local FrameIndex=1
	local FirstFrame=true

	while true do

		if
			IsCancelled(Token)
		then

			return false

		end

		local Frame=
			StartupFrames[
				FrameIndex
			]

		if not Frame then

			FrameIndex=1
			Frame=
				StartupFrames[1]

		end

		local FrameStart=
			os.clock()

		local OK=
			PaintFrame(
				Frame,
				FirstFrame,
				Token,
				true,
				false
			)

		FirstFrame=false

		if not OK then
			return false
		end

		FrameIndex+=1

		if
			FrameIndex>
			#StartupFrames
		then

			FrameIndex=1

		end

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

		local Elapsed=
			os.clock()-
			StartTime

		Status.Text=
			string.format(
				"STARTUP RGB %.1f/%.1f",
				math.min(
					Elapsed,
					STARTUP_DURATION
				),
				STARTUP_DURATION
			)

		if
			Elapsed>=
			STARTUP_DURATION
		then

			return true

		end

	end

end

local function PlayMode(
	Mode
)

	if
		Playing
		or
		Building
		or
		Scanning
		or
		Deleting
		or
		SettingPos
	then

		return

	end

	if
		next(Blocks)==nil
	then

		Status.Text=
			"BUILD OR SCAN FIRST"

		return

	end

	if
		not COLOR_ENABLED
	then

		Status.Text=
			"COLOR IS OFF"

		return

	end

	Playing=true

	local Token=
		NewRunToken()

	ResetPixelState()

	if Mode==true then

		PlayRGBButton.Text=
			"PREPARING RGB..."

	elseif Mode=="customba" then

		PlayCustomBAButton.Text=
			"PREPARING..."

	else

		PlayBadAppleButton.Text=
			"PREPARING..."

	end

	if
		not PreparePlayback(
			Mode
		)
	then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		PlayCustomBAButton.Text=
			"PLAY CUSTOM BA"

		return

	end

	if
		IsCancelled(Token)
	then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	if Mode==true then

		PlayRGBButton.Text=
			"STARTUP..."

	elseif Mode=="customba" then

		PlayCustomBAButton.Text=
			"STARTUP..."

	else

		PlayBadAppleButton.Text=
			"STARTUP..."

	end

	if
		not PlayStartup(Token)
	then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		PlayCustomBAButton.Text=
			"PLAY CUSTOM BA"

		Status.Text="STOPPED"

		return

	end

	if
		IsCancelled(Token)
	then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	local Frames
	local Label
	local RGBMode

	if Mode==true then

		Frames=RGBFrames
		Label="RGB"
		RGBMode=true

	elseif Mode=="customba" then

		Frames=CustomBAFrames
		Label="CUSTOM BA"
		RGBMode=false

	else

		Frames=BadAppleFrames
		Label="BAD APPLE"
		RGBMode=false

	end

	local FirstMainFrame=true

	for FrameNumber,Frame in
		ipairs(Frames)
	do

		if
			IsCancelled(Token)
		then

			break

		end

		local FrameStart=
			os.clock()

		local OK=
			PaintFrame(
				Frame,
				FirstMainFrame,
				Token,
				RGBMode,
				RGBMode
			)

		FirstMainFrame=false

		if not OK then
			break
		end

		Status.Text=
			string.format(
				"%s %d/%d",
				Label,
				FrameNumber,
				#Frames
			)

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

	end

	Playing=false

	Status.Text=
		IsCancelled(Token)
		and
		"STOPPED"
		or
		"PLAYBACK FINISHED"

	PlayBadAppleButton.Text=
		"PLAY BAD APPLE"

	PlayRGBButton.Text=
		"PLAY CUSTOM RGB"

	PlayCustomBAButton.Text=
		"PLAY CUSTOM BA"

	StopRequested=false

end

