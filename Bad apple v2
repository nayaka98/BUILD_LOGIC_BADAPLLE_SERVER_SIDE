local function ParseRGBFrame(Text)
	local Pixels={}

	for R,G,B in Text:gmatch(
		"(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
	) do
		R=tonumber(R)
		G=tonumber(G)
		B=tonumber(B)

		if R and G and B
			and R>=0 and R<=255
			and G>=0 and G<=255
			and B>=0 and B<=255 then

			Pixels[#Pixels+1]=Color3.fromRGB(
				R,
				G,
				B
			)
		end
	end

	if #Pixels~=TOTAL_BLOCKS then
		return nil
	end

	return Pixels
end

local function LoadRGB()
	if not RGB_URL then
		return true
	end

	if RGBFrames then
		return true
	end

	Status.Text="LOADING RGB..."

	local Text=LoadText(RGB_URL)

	if not Text then
		Status.Text="RGB DOWNLOAD FAILED"
		return false
	end

	local RawFrames=string.split(
		Text,
		"N"
	)

	RGBFrames={}

	for _,FrameText in ipairs(RawFrames) do
		local Frame=ParseRGBFrame(FrameText)

		if Frame then
			RGBFrames[
				#RGBFrames+1
			]=Frame
		end
	end

	if #RGBFrames==0 then
		RGBFrames=nil
		Status.Text="RGB EMPTY"
		return false
	end

	return true
end

