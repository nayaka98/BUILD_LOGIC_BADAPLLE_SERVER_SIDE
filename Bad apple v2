	end

	if Building then
		Status.Text="BUILDING..."
		return
	end

	if Scanning then
		Status.Text="SCANNING..."
		return
	end

	if next(Blocks)==nil then
		Status.Text="BUILD OR SCAN FIRST"
		return
	end

	if not COLOR_ENABLED then
		Status.Text="COLOR IS OFF"
		return
	end

	Playing=true

	local Token=NewRunToken()

	PlayButton.Text="PREPARING..."

	ResetPixelState()

	if not PreparePlayback() then
		Playing=false
		StopRequested=false
		PlayButton.Text="PLAY BAD APPLE"
		return
	end

	if IsCancelled(Token) then
		Playing=false
		PlayButton.Text="PLAY BAD APPLE"
		Status.Text="STOPPED"
		return
	end

	PlayButton.Text="STARTUP..."

	if not PlayStartup(Token) then
		Playing=false
		PlayButton.Text="PLAY BAD APPLE"
		Status.Text="STOPPED"
		return
	end

	if IsCancelled(Token) then
		Playing=false
		PlayButton.Text="PLAY BAD APPLE"
		Status.Text="STOPPED"
		return
	end

	local RGBMode=RGB_URL~=nil

	local Frames=
		RGBMode
		and RGBFrames
		or BadAppleFrames

	local Label=
		RGBMode
		and "RGB"
		or "BAD APPLE"

	Status.Text=
		RGBMode
		and "RGB PLAYBACK STARTING..."
		or "BAD APPLE STARTING..."

	local FirstMainFrame=true

	for FrameNumber,Frame in ipairs(Frames) do
		if IsCancelled(Token) then
			break
		end

		local FrameStart=os.clock()

		local OK=PaintFrame(
			Frame,
			FirstMainFrame,
			Token,
			RGBMode
		)

		FirstMainFrame=false

		if not OK then
			break
		end

		Status.Text=string.format(
			"%s %d/%d",
			Label,
			FrameNumber,
			#Frames
		)

		local Remaining=
			FRAME_DELAY-
			(os.clock()-FrameStart)

		if Remaining>0 then
			task.wait(Remaining)
		end
	end

	Playing=false

	Status.Text=
		IsCancelled(Token)
		and "STOPPED"
		or "PLAYBACK FINISHED"

	PlayButton.Text="PLAY BAD APPLE"
	StopRequested=false
end

BuildButton.Activated:Connect(function()
	if Building or Playing or Scanning then
		return
	end

	task.spawn(BuildGrid)
end)

ColorButton.Activated:Connect(function()
	COLOR_ENABLED=not COLOR_ENABLED

	ColorButton.Text=
		COLOR_ENABLED
		and "COLOR : ON"
		or "COLOR : OFF"
end)

PlayButton.Activated:Connect(function()
	if Playing then
		CancelRun()
		return
	end

	if Building or Scanning then
		return
	end

	task.spawn(PlayBadApple)
end)

StopButton.Activated:Connect(function()
	CancelRun()

	Status.Text="STOPPING..."
	PlayButton.Text="PLAY BAD APPLE"
end)

ScanButton.Activated:Connect(function()
	if Building or Playing or Scanning then
		return
	end

	task.spawn(ScanBlocks)
end)

print("BUILD LOGIC BAD APPLE")
print("Grid:",X_SIZE,"x",Y_SIZE)
print("Total:",TOTAL_BLOCKS)
print("Build workers:",BUILD_WORKERS)
print("Build batch:",BUILD_BATCH)
print("Paint workers:",PAINT_WORKERS)
print("Paint batch:",PAINT_BATCH)
print("Scan radius:",SCAN_RADIUS)
print("Startup:",STARTUP_DURATION)
print("RGB URL:",RGB_URL or "DISABLED")
