local function PreparePlayback(
	RGBMode
)

	if
		not LoadStartup()
	then

		return false

	end

	if RGBMode then

		return
			LoadRGB()

	end

	return
		LoadBadApple()

end

local function PlayStartup(
	Token
)

	local StartTime=
		os.clock()

	local FrameIndex=1
	local FirstFrame=true

	while true do

		if
			IsCancelled(Token)
		then

			return false

		end

		local Frame=
			StartupFrames[
				FrameIndex
			]

		if not Frame then

			FrameIndex=1

			Frame=
				StartupFrames[1]

		end

		local FrameStart=
			os.clock()

		-- STARTUP SEKARANG RGB
		local OK=
			PaintFrame(
				Frame,
				FirstFrame,
				Token,
				true
			)

		FirstFrame=false

		if not OK then
			return false
		end

		FrameIndex+=1

		if
			FrameIndex>
			#StartupFrames
		then

			FrameIndex=1

		end

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

		local Elapsed=
			os.clock()-
			StartTime

		Status.Text=
			string.format(
				"STARTUP RGB %.1f/%.1f",
				math.min(
					Elapsed,
					STARTUP_DURATION
				),
				STARTUP_DURATION
			)

		if
			Elapsed>=
			STARTUP_DURATION
		then

			return true

		end

	end

end

local function PlayMode(
	RGBMode
)

	if Playing then
		return
	end

	if Building then

		Status.Text=
			"BUILDING..."

		return

	end

	if Scanning then

		Status.Text=
			"SCANNING..."

		return

	end

	if
		next(Blocks)==nil
	then

		Status.Text=
			"BUILD OR SCAN FIRST"

		return

	end

	if not COLOR_ENABLED then

		Status.Text=
			"COLOR IS OFF"

		return

	end

	Playing=true

	local Token=
		NewRunToken()

	ResetPixelState()

	if RGBMode then

		PlayRGBButton.Text=
			"PREPARING RGB..."

	else

		PlayBadAppleButton.Text=
			"PREPARING..."

	end

	if not PreparePlayback(RGBMode) then

		Playing=false
		StopRequested=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		return

	end

	if IsCancelled(Token) then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		Status.Text="STOPPED"

		return

	end

	if RGBMode then

		PlayRGBButton.Text=
			"STARTUP..."

	else

		PlayBadAppleButton.Text=
			"STARTUP..."

	end

	-- STARTUP RGB 3 DETIK
	if not PlayStartup(Token) then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		Status.Text="STOPPED"

		return

	end

	if IsCancelled(Token) then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		Status.Text="STOPPED"

		return

	end

	local Frames=
		RGBMode
		and
		RGBFrames
		or
		BadAppleFrames

	local Label=
		RGBMode
		and
		"RGB"
		or
		"BAD APPLE"

	Status.Text=
		RGBMode
		and
		"RGB PLAYBACK STARTING..."
		or
		"BAD APPLE STARTING..."

	local FirstMainFrame=true

	for FrameNumber,Frame in
		ipairs(
			Frames
		)
	do

		if
			IsCancelled(Token)
		then

			break

		end

		local FrameStart=
			os.clock()

		local OK=
			PaintFrame(
				Frame,
				FirstMainFrame,
				Token,
				RGBMode
			)

		FirstMainFrame=false

		if not OK then
			break
		end

		Status.Text=
			string.format(
				"%s %d/%d",
				Label,
				FrameNumber,
				#Frames
			)

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

	end

	Playing=false

	Status.Text=
		IsCancelled(Token)
		and
		"STOPPED"
		or
		"PLAYBACK FINISHED"

	PlayBadAppleButton.Text=
		"PLAY BAD APPLE"

	PlayRGBButton.Text=
		"PLAY CUSTOM RGB"

	StopRequested=false

end

