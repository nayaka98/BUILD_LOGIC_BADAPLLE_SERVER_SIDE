	)

local function ApplyBrightness(
	Color
)

	local R=
		math.floor(
			Color.R*255+
			0.5
		)

	local G=
		math.floor(
			Color.G*255+
			0.5
		)

	local B=
		math.floor(
			Color.B*255+
			0.5
		)

	R=
		math.min(
			255,
			R+
			CUSTOM_BRIGHTNESS
		)

	G=
		math.min(
			255,
			G+
			CUSTOM_BRIGHTNESS
		)

	B=
		math.min(
			255,
			B+
			CUSTOM_BRIGHTNESS
		)

	R=
		math.max(
			0,
			R
		)

	G=
		math.max(
			0,
			G
		)

	B=
		math.max(
			0,
			B
		)

	return
		Color3.fromRGB(
			R,
			G,
			B
		)

end

