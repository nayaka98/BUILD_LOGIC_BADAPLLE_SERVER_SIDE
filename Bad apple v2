local function GetCharacter(
	Frame,
	X,
	Y
)

	local FrameY=
		Y_SIZE-
		1-
		Y

	local Index=
		FrameY*
		X_SIZE+
		X+
		1

	local Byte=
		string.byte(
			Frame,
			Index
		)

	if
		Byte==65
	then

		return "A"

	end

	if
		Byte==66
	then

		return "B"

	end

	return nil

end

