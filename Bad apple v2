			WindowStart.X.Offset+
				Delta.X,
			WindowStart.Y.Scale,
			WindowStart.Y.Offset+
				Delta.Y
		)

end)

local function MathRound(Value)

	return math.floor(
		Value+0.5
	)

end

local OriginPosition=
	PosOriginPart.Position

local function PosMonde2Grille(
	WorldPosition
)

	local X=
		MathRound(
			(
				WorldPosition.X-
				OriginPosition.X
			)/
			GRANDEUR_BLOC
		)

	local Y=
		MathRound(
			(
				WorldPosition.Y-
				OriginPosition.Y
			)/
			GRANDEUR_BLOC
		)

	local Z=
		MathRound(
			(
				WorldPosition.Z-
				OriginPosition.Z
			)/
			GRANDEUR_BLOC
		)

	return Vector3.new(
		X,
		Y,
		Z
	)

end

local function GridToWorld(X,Y,Z)

	return
		OriginPosition+
		Vector3.new(
			X*GRANDEUR_BLOC,
			Y*GRANDEUR_BLOC,
			Z*GRANDEUR_BLOC
		)

end

local function Position2CodePosition(
	Position
)

	local X=
		math.floor(
			tonumber(Position.X)
			or
			-1
		)

	local Y=
		math.floor(
			tonumber(Position.Y)
			or
			-1
		)

	local Z=
		math.floor(
			tonumber(Position.Z)
			or
			-1
		)

	if
		X<0
		or
		X>=256
		or
		Y<0
		or
		Y>=256
		or
		Z<0
		or
		Z>=256
	then

		return nil

	end

	local Buffer=
		BitBuffer:Create()

	Buffer:WriteUnsigned(
		8,
		X
	)

	Buffer:WriteUnsigned(
		8,
		Y
	)

	Buffer:WriteUnsigned(
		8,
		Z
	)

	return
		Buffer:ToBase64()

end

local function NewRunToken()

	RunToken+=1
	StopRequested=false

	return RunToken

end

local function CancelRun()

	RunToken+=1
	StopRequested=true

end

local function IsCancelled(Token)

	return
		StopRequested
		or
		Token~=RunToken

end

local function PlaceBlock(Data)

	local OK,Result=
		pcall(function()

			return
				PlacerBloc:InvokeServer(
					BLOCK_ID,
					Data.code,
					nil,
					nil,
					Data.key,
					"A"
				)

		end)

	if not OK then

		return false,
			tostring(Result)

	end

	return true,Result

end

local function GetObjFromBox(
	Box
)

	if not Box then
		return nil
	end

	local Current=
		Box

	for _=1,4 do

		local Parent=
			Current.Parent

		if
			Parent==Blocs
		then

			return Current

		end

		Current=Parent

		if not Current then
			return nil
		end

	end

	return nil

end

local function CacheBoxesFromWorkspace()

	local Found=0

	for _,Object in
		ipairs(
			Blocs:GetDescendants()
		)
	do

		if
			Object:IsA("BasePart")
			and
			Object.Name=="Box"
		then

			local Grid=
				PosMonde2Grille(
					Object.Position
				)

			local X=Grid.X
			local Y=Grid.Y
			local Z=Grid.Z

			if
				X>=START_X
				and
				X<START_X+X_SIZE
				and
				Y>=START_Y
				and
				Y<START_Y+Y_SIZE
				and
				Z==START_Z
			then

				local Expected=
					GridToWorld(
						X,
						Y,
						Z
					)

				if
					(
						Object.Position-
						Expected
					).Magnitude<=
					SCAN_RADIUS
				then

					local Key=
						string.format(
							"%d_%d_%d",
							X,
							Y,
							Z
						)

					if not Blocks[Key] then

						local Block=
							GetObjFromBox(
								Object
							)

						if Block then

							Blocks[Key]=
								{
									x=X,
									y=Y,
									z=Z,
									key=Key,
									code=
										Position2CodePosition(
											Grid
										),
									world=Expected,
									box=Object,
									block=Block
								}

							Found+=1

						end

					end

				end

			end

		end

	end

	return Found

end

local function WaitForBuiltBoxes(Token)

	local Found=0

	for _=1,
		BUILD_RESCAN_ATTEMPTS
	do

		if
			IsCancelled(Token)
		then

			return false,Found

		end

		Found=
			CacheBoxesFromWorkspace()

		Status.Text=
			string.format(
				"SYNC BLOCKS %d/%d",
				Found,
				TOTAL_BLOCKS
			)

		if
			Found>=TOTAL_BLOCKS
		then

			return true,Found

		end

		task.wait(
			BUILD_RESCAN_DELAY
		)

	end

	return Found>0,Found

end

local function PrepareBuildData()

	local Data=
		table.create(
			TOTAL_BLOCKS
		)

	local Index=0

	for Y=START_Y,
		START_Y+Y_SIZE-1
	do

		for X=START_X,
			START_X+X_SIZE-1
		do

			Index+=1

			local Grid=
				Vector3.new(
					X,
					Y,
					START_Z
				)

			Data[Index]=
				{
					x=X,
					y=Y,
					z=START_Z,

					key=
						string.format(
							"%d_%d_%d",
							X,
							Y,
							START_Z
						),

					code=
						Position2CodePosition(
							Grid
						),

					world=
						GridToWorld(
							X,
							Y,
							START_Z
						)
				}

		end

	end

	return Data

end

local function BuildGrid()

	if
		Building
		or
		Playing
		or
		Scanning
		or
		Deleting
	then

		Status.Text="BUSY"
		return

	end

	Building=true

	local Token=
		NewRunToken()

	table.clear(Blocks)

	Status.Text=
		"PREPARING BUILD..."

	local BuildData=
		PrepareBuildData()

	local NextIndex=0
	local Completed=0
	local Failed=0
	local WorkersDone=0

	local function Worker()

		while true do

			if IsCancelled(Token) then
				break
			end

			local Index=
				NextIndex+1

			NextIndex=Index

			if
				Index>TOTAL_BLOCKS
			then

				break

			end

			local Success=
				PlaceBlock(
					BuildData[Index]
				)

			if IsCancelled(Token) then
				break
			end

			if Success then
				Completed+=1
			else
				Failed+=1
			end

			if
				Completed%BUILD_BATCH==0
			then

				Status.Text=
					string.format(
						"BUILD %d/%d",
						Completed,
						TOTAL_BLOCKS
					)

				task.wait()

			end

		end

		WorkersDone+=1

	end

	for _=1,
		BUILD_WORKERS
	do

		task.spawn(
			Worker
		)

	end

	while
		WorkersDone<BUILD_WORKERS
	do

		if IsCancelled(Token) then

			Building=false
			Status.Text="STOPPED"

			return

		end

		Status.Text=
			string.format(
				"BUILD %d/%d",
				Completed,
				TOTAL_BLOCKS
			)

		task.wait()

	end

	if IsCancelled(Token) then

		Building=false
		Status.Text="STOPPED"

		return

	end

	Status.Text=
		string.format(
			"PLACED %d/%d",
			Completed,
			TOTAL_BLOCKS
		)

	task.wait(0.25)

	local Synced,Found=
		WaitForBuiltBoxes(
			Token
		)

	Building=false

	if not Synced then

		Status.Text=
			string.format(
				"BUILD DONE • %d BOX",
				Found
			)

		return

	end

	Status.Text=
		string.format(
			"READY • %d/%d BLOCKS",
			Found,
			TOTAL_BLOCKS
		)

	print(
		"BUILD:",
		Completed,
		"/",
		TOTAL_BLOCKS
	)

	print(
		"FAILED:",
		Failed
	)

	print(
		"CACHED:",
		Found
	)

end

local function DeleteOneBlock(Data)

	if
		not Data
		or
		not Data.block
	then

		return false,
			"BLOCK NIL"

	end

	local Block=
		Data.block

	if
		not Block.Parent
	then

		return true,
			"ALREADY REMOVED"

	end

	local OriginalParent=
		Block.Parent

	local P=
		Block:GetAttribute(
			"p"
		)

	Block:SetAttribute(
		"t",
		os.clock()
	)

	Block.Parent=
		FauxBlocsDetruits

	local V1=nil
	local V2=nil
	local V3=nil
	local V4=nil

	local OK,Err=
		pcall(function()

			V1,V2,V3,V4=
				DeleteBloc:InvokeServer(
					nil,
					nil,
					nil,
					Block
				)

		end)

	if not OK then

		if
			Block.Parent==
				FauxBlocsDetruits
		then

			Block.Parent=
				OriginalParent

			Block:SetAttribute(
				"t",
				nil
			)

		end

		return false,
			tostring(Err)

	end

	if V1==-1 then

		return false,
			"SERVER -1"

	end

	if V1==true then

		return true,
			P

	end

	if
		V4
		and
		typeof(V4)=="Instance"
	then

		pcall(function()

			V4.Parent=
				Blocs

			V4:SetAttribute(
				"t",
				nil
			)

		end)

	elseif
		Block
		and
		Block.Parent==
			FauxBlocsDetruits
	then

		Block.Parent=
			OriginalParent

		Block:SetAttribute(
			"t",
			nil
		)

	end

	return false,
		tostring(
			V2
			or
			V3
			or
			"DELETE FAILED"
		)

end

local function DeleteAllBlocks()

	if
		Deleting
		or
		Building
		or
		Playing
		or
		Scanning
	then

		return

	end

	Deleting=true

	local Token=
		NewRunToken()

	table.clear(Blocks)

	Status.Text=
		"SCANNING BLOCKS..."

	local Found=
		CacheBoxesFromWorkspace()

	if IsCancelled(Token) then

		Deleting=false
		Status.Text="STOPPED"

		return

	end

	if Found<=0 then

		Deleting=false
		Status.Text="NO BLOCK FOUND"

		return

	end

	local List=
		table.create(
			Found
		)

	local Count=0

	for _,Data in
		pairs(Blocks)
	do

		if
			Data
			and
			Data.block
			and
			Data.block.Parent==
				Blocs
		then

			Count+=1
			List[Count]=Data

		end

	end

	if Count==0 then

		Deleting=false
		Status.Text=
			"NO VALID BLOCK FOUND"

		return

	end

	local Completed=0
	local Failed=0
	local NextIndex=0

	Status.Text=
		string.format(
			"DELETE 0/%d",
			Count
		)

	local BatchStart=1

	while
		BatchStart<=Count
	do

		if IsCancelled(Token) then

			Deleting=false
			Status.Text="STOPPED"

			return

		end

		local BatchEnd=
			math.min(
				BatchStart+
				DELETE_BATCH-
				1,
				Count
			)

		local BatchCount=
			BatchEnd-
			BatchStart+
			1

		local WorkersDone=0
		local BatchNext=0

		local WorkerCount=
			math.min(
				DELETE_WORKERS,
				BatchCount
			)

		local function Worker()

			while true do

				if IsCancelled(Token) then
					break
				end

				local LocalIndex=
					BatchNext+1

				BatchNext=
					LocalIndex

				if
					LocalIndex>BatchCount
				then

					break

				end

				local GlobalIndex=
					BatchStart+
					LocalIndex-
					1

				local Data=
					List[GlobalIndex]

				local Success,Error=
					DeleteOneBlock(
						Data
					)

				if IsCancelled(Token) then
					break
				end

				if Success then

					Completed+=1

					Blocks[
						Data.key
					]=nil

				else

					Failed+=1

					warn(
						"[DELETE]",
						Data.key,
						Error
					)

				end

			end

			WorkersDone+=1

		end

		for _=1,
			WorkerCount
		do

			task.spawn(
				Worker
			)

		end

		while
			WorkersDone<WorkerCount
		do

			if IsCancelled(Token) then

				Deleting=false
				Status.Text="STOPPED"

				return

			end

			Status.Text=
				string.format(
					"DELETE %d/%d • FAIL %d",
					Completed,
					Count,
					Failed
				)

			task.wait()

		end

		BatchStart=
			BatchEnd+
			1

	end

	table.clear(
		Blocks
	)

	table.clear(
		PreviousPixels
	)

	Deleting=false

	Status.Text=
		string.format(
			"DELETED %d/%d • FAILED %d",
			Completed,
			Count,
			Failed
		)

	print(
		"DELETE:",
		Completed,
		"/",
		Count
	)

	print(
		"DELETE FAILED:",
		Failed
	)

end

