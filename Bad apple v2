	end

	if not PreparePlayback(RGBMode) then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		return

	end

	if IsCancelled(Token) then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	if RGBMode then

		PlayRGBButton.Text=
			"STARTUP..."

	else

		PlayBadAppleButton.Text=
			"STARTUP..."

	end

	if not PlayStartup(Token) then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"PLAY CUSTOM RGB"

		Status.Text="STOPPED"

		return

	end

	if IsCancelled(Token) then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	local Frames=
		RGBMode
		and
		RGBFrames
		or
		BadAppleFrames

	local Label=
		RGBMode
		and
		"RGB"
		or
		"BAD APPLE"

	local FirstMainFrame=true

	for FrameNumber,Frame in
		ipairs(Frames)
	do

		if
			IsCancelled(Token)
		then

			break

		end

		local FrameStart=
			os.clock()

		local OK=
			PaintFrame(
				Frame,
				FirstMainFrame,
				Token,
				RGBMode
			)

		FirstMainFrame=false

		if not OK then
			break
		end

		Status.Text=
			string.format(
				"%s %d/%d",
				Label,
				FrameNumber,
				#Frames
			)

		local Remaining=
			FRAME_DELAY-
			(
				os.clock()-
				FrameStart
			)

		if Remaining>0 then

			task.wait(
				Remaining
			)

		end

	end

	Playing=false

	Status.Text=
		IsCancelled(Token)
		and
		"STOPPED"
		or
		"PLAYBACK FINISHED"

	PlayBadAppleButton.Text=
		"PLAY BAD APPLE"

	PlayRGBButton.Text=
		"PLAY CUSTOM RGB"

	StopRequested=false

end

