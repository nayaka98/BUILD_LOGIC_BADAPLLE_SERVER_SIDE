local function PlayBadApple()

    if Playing then
        return
    end

    if
        next(Blocks) == nil
    then

        Status.Text =
            "BUILD FIRST"

        return
    end

    if not ColorEnabled then

        Status.Text =
            "COLOR IS OFF"

        return
    end

    Playing = true
    StopRequested = false

    PlayButton.Text =
        "PLAYING..."

    --==========================================================
    -- STARTUP 5 DETIK
    --==========================================================

    if not PlayStartup() then

        Playing = false

        StopRequested = false

        PlayButton.Text =
            "PLAY BAD APPLE"

        return
    end

    if StopRequested then

        Playing = false

        StopRequested = false

        PlayButton.Text =
            "PLAY BAD APPLE"

        Status.Text =
            "STOPPED"

        return
    end

    --==========================================================
    -- LOAD BAD APPLE UTAMA
    --==========================================================

    if not LoadBadApple() then

        Playing = false

        StopRequested = false

        PlayButton.Text =
            "PLAY BAD APPLE"

        return
    end

    --==========================================================
    -- BAD APPLE FRAME LOOP
    --==========================================================

    table.clear(
        PreviousPixels
    )

    for FrameNumber,
        Frame in
        ipairs(
            BadAppleFrames
        )
    do

        if StopRequested then
            break
        end

        local Calls = 0

        -- EXACT 51 × 39
        for Y = 0,
            Y_SIZE - 1
        do

            if StopRequested then
                break
            end

            --==================================================
            -- FIX ROTASI VERTICAL
            --
            -- File Bad Apple:
            --   FrameY 0  = bagian ATAS
            --
            -- Roblox Grid:
            --   Y 0      = bagian BAWAH
            --
            -- Maka dibalik:
            --   FrameY = Y_SIZE - 1 - Y
            --==================================================

            local FrameY =
                Y_SIZE - 1 - Y

            local Row =
                string.sub(
                    Frame,

                    FrameY * X_SIZE + 1,

                    (FrameY + 1)
                        * X_SIZE
                )

            for X = 0,
                X_SIZE - 1
            do

                if StopRequested then
                    break
                end

                local Character =
                    string.sub(
                        Row,
                        X + 1,
                        X + 1
                    )

                if
                    Character == "A"
                    or
                    Character == "B"
                then

                    local Key =
                        string.format(
                            "%d_%d_%d",
                            X + START_X,
                            Y + START_Y,
                            START_Z
                        )

                    local Data =
                        Blocks[Key]

                    if Data then

                        -- Hanya kirim jika berubah.
                        if
                            PreviousPixels[Key]
                            ~= Character
                        then

                            PreviousPixels[Key] =
                                Character

                            if
                                Character == "A"
                            then

                                PaintBox(
                                    Data.box,
                                    WHITE
                                )

                            else

                                PaintBox(
                                    Data.box,
                                    BLACK
                                )

                            end

                            Calls += 1

                            if
                                Calls >= PAINT_BATCH
                            then

                                Calls = 0

                                task.wait()

                            end
                        end
                    end
                end
            end
        end

        Status.Text =
            string.format(
                "BAD APPLE %d/%d",
                FrameNumber,
                #BadAppleFrames
            )

        task.wait(
            FRAME_DELAY
        )
    end

    Playing = false
    StopRequested = false

    PlayButton.Text =
        "PLAY BAD APPLE"

    Status.Text =
        "PLAYBACK FINISHED"
end

