--==============================================================
-- PLAY STARTUP
--
-- Startup file boleh memiliki durasi/frame count apa saja.
-- Playback tetap berlangsung selama STARTUP_DURATION.
--
-- Jika frame habis sebelum 5 detik:
--   kembali ke frame 1.
--
-- Jika startup punya frame lebih panjang:
--   hanya diputar sampai 5 detik.
--==============================================================

local function PlayStartup()

    if not LoadStartup() then
        return false
    end

    Status.Text =
        "STARTUP..."

    local StartTime =
        os.clock()

    local FrameIndex = 1

    while
        os.clock() - StartTime
        < STARTUP_DURATION
    do

        if StopRequested then
            return false
        end

        local Frame =
            StartupFrames[
                FrameIndex
            ]

        if Frame then

            local Calls = 0

            -- EXACT 51 × 39
            for Y = 0,
                Y_SIZE - 1
            do

                if StopRequested then
                    return false
                end

                -- Sama seperti Bad Apple:
                -- vertical flip
                local FrameY =
                    Y_SIZE - 1 - Y

                local Row =
                    string.sub(
                        Frame,

                        FrameY * X_SIZE + 1,

                        (FrameY + 1)
                            * X_SIZE
                    )

                for X = 0,
                    X_SIZE - 1
                do

                    if StopRequested then
                        return false
                    end

                    local Character =
                        string.sub(
                            Row,
                            X + 1,
                            X + 1
                        )

                    if
                        Character == "A"
                        or
                        Character == "B"
                    then

                        local Key =
                            string.format(
                                "%d_%d_%d",
                                X + START_X,
                                Y + START_Y,
                                START_Z
                            )

                        local Data =
                            Blocks[Key]

                        if Data then

                            if
                                Character == "A"
                            then

                                PaintBox(
                                    Data.box,
                                    WHITE
                                )

                            else

                                PaintBox(
                                    Data.box,
                                    BLACK
                                )

                            end

                            Calls += 1

                            if
                                Calls >= PAINT_BATCH
                            then

                                Calls = 0

                                task.wait()

                            end
                        end
                    end
                end
            end
        end

        local Elapsed =
            os.clock() - StartTime

        Status.Text =
            string.format(
                "STARTUP %.1f/%.1f",
                math.min(
                    Elapsed,
                    STARTUP_DURATION
                ),
                STARTUP_DURATION
            )

        FrameIndex += 1

        -- Loop startup kalau frame sudah habis.
        if
            FrameIndex > #StartupFrames
        then

            FrameIndex = 1

        end

        task.wait(
            FRAME_DELAY
        )
    end

    Status.Text =
        "STARTUP DONE"

    return true
end

