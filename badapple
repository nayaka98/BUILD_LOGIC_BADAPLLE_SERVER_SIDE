Header.InputBegan:Connect(
    function(Input)

        if
            Input.UserInputType ==
                Enum.UserInputType.Touch
            or
            Input.UserInputType ==
                Enum.UserInputType.MouseButton1
        then

            Dragging = true

            DragStart =
                Input.Position

            WindowStart =
                Window.Position
        end
    end
)

Header.InputEnded:Connect(
    function(Input)

        if
            Input.UserInputType ==
                Enum.UserInputType.Touch
            or
            Input.UserInputType ==
                Enum.UserInputType.MouseButton1
        then

            Dragging = false
        end
    end
)

Header.InputChanged:Connect(
    function(Input)

        if
            Input.UserInputType ==
                Enum.UserInputType.Touch
            or
            Input.UserInputType ==
                Enum.UserInputType.MouseMovement
        then

            DragInput = Input
        end
    end
)

UserInputService.InputChanged:Connect(
    function(Input)

        if
            not Dragging
            or
            Input ~= DragInput
        then
            return
        end

        local Delta =
            Input.Position
            - DragStart

        Window.Position =
            UDim2.new(
                WindowStart.X.Scale,
                WindowStart.X.Offset
                    + Delta.X,

                WindowStart.Y.Scale,
                WindowStart.Y.Offset
                    + Delta.Y
            )
    end
)

--==============================================================
-- ORIGINAL BUILD LOGIC FUNCTIONS
--==============================================================

local function MathRound(
    Value
)

    return math.floor(
        Value + 0.5
    )
end

--==============================================================
-- WORLD -> GRID
--==============================================================

local function PosMonde2Grille(
    WorldPosition
)

    local Origin =
        PosOriginPart.Position

    local X =
        MathRound(
            (
                WorldPosition.X
                - Origin.X
            )
            / GRANDEUR_BLOC
        )

    local Y =
        MathRound(
            (
                WorldPosition.Y
                - Origin.Y
            )
            / GRANDEUR_BLOC
        )

    local Z =
        MathRound(
            (
                WorldPosition.Z
                - Origin.Z
            )
            / GRANDEUR_BLOC
        )

    return
        Vector3.new(
            X,
            Y,
            Z
        )
end

--==============================================================
-- GRID -> WORLD
--==============================================================

local function GridToWorld(
    X,
    Y,
    Z
)

    return
        PosOriginPart.Position
        + Vector3.new(
            X * GRANDEUR_BLOC,
            Y * GRANDEUR_BLOC,
            Z * GRANDEUR_BLOC
        )
end

--==============================================================
-- ORIGINAL Position2CodePosition
--==============================================================

local function Position2CodePosition(
    Position
)

    local X =
        tonumber(Position.X)

    local Y =
        tonumber(Position.Y)

    local Z =
        tonumber(Position.Z)

    if
        not X
        or
        not Y
        or
        not Z
    then

        return nil
    end

    X = math.floor(X)
    Y = math.floor(Y)
    Z = math.floor(Z)

    if
        X < 0 or X >= 256
        or
        Y < 0 or Y >= 256
        or
        Z < 0 or Z >= 256
    then

        return nil
    end

    local Buffer =
        BitBuffer:Create()

    Buffer:WriteUnsigned(
        8,
        X
    )

    Buffer:WriteUnsigned(
        8,
        Y
    )

    Buffer:WriteUnsigned(
        8,
        Z
    )

    return Buffer:ToBase64()
end

--==============================================================
-- GET BOX
--==============================================================

local function FindBoxAt(
    WorldPosition
)

    local Best
    local BestDistance =
        math.huge

    for _, Object in
        ipairs(
            Blocs:GetDescendants()
        )
    do

        if
            Object:IsA("BasePart")
            and
            Object.Name == "Box"
        then

            local Distance =
                (
                    Object.Position
                    - WorldPosition
                ).Magnitude

            if
                Distance < BestDistance
            then

                BestDistance =
                    Distance

                Best =
                    Object
            end
        end
    end

    if
        Best
        and
        BestDistance <= 1.75
    then

        return Best
    end

    return nil
end

local function WaitForBox(
    WorldPosition
)

    local Deadline =
        os.clock() + 4

    repeat

        local Box =
            FindBoxAt(
                WorldPosition
            )

        if Box then
            return Box
        end

        task.wait(
            0.05
        )

    until
        os.clock()
        >= Deadline

    return nil
end

--==============================================================
-- PLACE ONE BLOCK
--==============================================================

local function PlaceBlock(
    GridX,
    GridY,
    GridZ
)

    if
        GridX < 0 or GridX >= 256
        or
        GridY < 0 or GridY >= 256
        or
        GridZ < 0 or GridZ >= 256
    then

        return false,
            "GRID_OUTSIDE_8BIT"
    end

    local Grid =
        Vector3.new(
            GridX,
            GridY,
            GridZ
        )

    local Code =
        Position2CodePosition(
            Grid
        )

    if not Code then

        return false,
            "ENCODE_FAILED"
    end

    local Key =
        string.format(
            "%d_%d_%d",
            GridX,
            GridY,
            GridZ
        )

    local ok,
          result =
        pcall(
            function()

                return
                    PlacerBloc:InvokeServer(
                        BLOCK_ID,
                        Code,
                        nil,
                        nil,
                        Key,
                        "A"
                    )
            end
        )

    if not ok then

        return false,
            tostring(result)
    end

    return true,
        {
            x = GridX,
            y = GridY,
            z = GridZ,
            key = Key,
            code = Code,
            world =
                GridToWorld(
                    GridX,
                    GridY,
                    GridZ
                )
        }
end

--==============================================================
-- BUILD 51x39
--==============================================================

local function BuildGrid()

    if Building then
        return
    end

    Building = true
    StopRequested = false

    table.clear(
        Blocks
    )

    Status.Text =
        "BUILDING 0/"
        .. TOTAL_BLOCKS

    local count = 0

    for Y = START_Y,
        START_Y + Y_SIZE - 1
    do

        for X = START_X,
            START_X + X_SIZE - 1
        do

            if StopRequested then

                Building = false

                Status.Text =
                    "STOPPED"

                return
            end

            local Success,
                  Data =
                PlaceBlock(
                    X,
                    Y,
                    START_Z
                )

            if Success then

                count += 1

                local Box =
                    WaitForBox(
                        Data.world
                    )

                Data.box =
                    Box

                Blocks[
                    Data.key
                ] =
                    Data

            else

                warn(
                    "[BUILD]",
                    X,
                    Y,
                    Data
                )
            end

            Status.Text =
                string.format(
                    "BUILD %d/%d",
                    count,
                    TOTAL_BLOCKS
                )

            task.wait()

        end
    end

    Building = false

    Status.Text =
        string.format(
            "READY • %d BLOCKS",
            count
        )

    print(
        "BAD APPLE GRID:",
        count,
        "/",
        TOTAL_BLOCKS
    )
end

